DATABASE_URL=postgres://finhub:change-me@localhost:5432/finhub
POSTGRES_PASSWORD=change-me
PORT=3000
ROLE=all
# true = seed fake demo accounts/transactions once at startup (after migrations). Default off.
DEMO_SEED=false
# Shared-password gate (HTTP Basic over every route except /healthz and the Telegram webhook).
# Empty = off. A stopgap for an internet-exposed demo, NOT real auth. Put HTTPS in front.
FINHUB_ACCESS_PASSWORD=
FINHUB_ACCESS_USER=demo
DEFAULT_WORKSPACE_ID=
DEFAULT_WORKSPACE_SLUG=demo
# Telegram bot (optional). The webhook route is mounted only when BOTH token and secret are set.
# Webhook URL to register with Telegram: https://<host>/telegram/webhook/<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated chat ids allowed to use the bot; everyone else is ignored (empty = nobody).
TELEGRAM_ALLOWED_CHAT_IDS=
